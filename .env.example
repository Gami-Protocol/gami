# Root / server env for local Edge Function emulation and gami-site API routes.
# On hosted Supabase Edge Functions these are injected automatically.
#
# NEVER commit a real SUPABASE_SECRET_KEY. Keep it in .env.local / Vercel / Supabase secrets.

SUPABASE_URL=https://xetqhdzvbfeiedbmopew.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ek2XR2KnO2sQHjiOHfLGTA_EMw5MCxS
SUPABASE_JWKS_URL=https://xetqhdzvbfeiedbmopew.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=

# Optional ops
WAITLIST_ADMIN_SECRET=
RESEND_API_KEY=
WAITLIST_ALERT_EMAILS=waitlist@gamiprotocol.io

# --- Shared Gami identity + .gami DNS ---------------------------------------
# Cloudflare Turnstile secret for the `gami-identity` edge function. Leave empty
# to skip captcha verification (captcha is then not enforced on that endpoint).
TURNSTILE_SECRET_KEY=

# --- Privy (identity + embedded wallets) ------------------------------------
# Signup, login and the wallet are all privy.io. The app ID is public and is
# baked into the client builds (app.config.ts / gami-web/src/lib/env.ts).
PRIVY_APP_ID=cmrz2f6jc01560djmtczc288n
EXPO_PUBLIC_PRIVY_APP_ID=cmrz2f6jc01560djmtczc288n
# Optional native app client (Privy Dashboard -> App clients).
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# SERVER ONLY. Never commit this and never expose it to a client bundle — it
# authenticates Gami as the Privy app owner (wallet + user REST APIs).
# Set it in Supabase secrets / Vercel env / .env.local instead.
PRIVY_APP_SECRET=
